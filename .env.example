# StudyTrack — environment variables
#
# Copy this file to .env and fill in real values if you ever wire up a
# real LLM/embedding provider. Never commit the real .env file — it is
# already excluded in .gitignore.
#
# This project ships with AI_MODE=mock as the default and does not
# require any of the variables below to run. They are placeholders for
# the optional AI_MODE=real path described in the README (not
# implemented in this submission — no API key of any kind is used or
# committed).

# "mock" (default, fully offline) or "real" (requires an API key below)
AI_MODE=mock

# Only needed if AI_MODE=real — API key for your chosen LLM/embedding
# provider (e.g. OpenAI, Anthropic, Google). Leave blank in this file;
# put the real value only in your local, untracked .env.
LLM_API_KEY=